{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/limite-claude-md.mjs", "post"],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/limite-claude-md.mjs", "inicio"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
