# Copie para .env (os scripts iniciar fazem isso). O .env NUNCA vai para o git.

# ---------- IA ----------
# mock      = offline, sem chave, respostas roteirizadas (plano B da demo)
# groq      = grátis, chave em https://console.groq.com/keys
# gemini    = grátis, chave em https://aistudio.google.com/apikey
# ollama    = local, sem chave (instale em https://ollama.com e baixe um modelo com tool calling)
# openai / anthropic = pagos
LLM_PROVIDER=mock

# Nome do modelo. NÃO chute: rode `python -m app.agente.listar_modelos` dentro de backend/
# e escolha um modelo com suporte a tool calling. Vazio no anthropic = claude-opus-5-5.
LLM_MODEL=

# Chave do provedor escolhido (ou use GROQ_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY)
LLM_API_KEY=

# Opcional: URL base própria de um serviço compatível com OpenAI
LLM_BASE_URL=

# Só anthropic: esforço de raciocínio (low, medium, high)
LLM_EFFORT=low

# ---------- iFood ----------
# mock = loja de demonstração local (selo DEMONSTRAÇÃO na tela)
# real = Merchant API do iFood (precisa de credenciais do Portal do Desenvolvedor)
IFOOD_MODE=mock
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_BASE_URL=https://merchant-api.ifood.com.br

# ---------- MCP do consumidor do iFood (Match) ----------
# demo = servidor MCP de demonstração em processo (dados fictícios, selo DEMONSTRAÇÃO; sem internet nem credencial)
# real = MCP oficial https://consumer-mcp.ifood.com.br/marketplace com login OAuth da conta de teste
#        (depois de subir o app, abra http://localhost:8000/oauth/login e entre com a conta de teste do Portal)
IFOOD_MCP_MODO=demo
# client_id/secret do agente no Portal https://mcp-developer.ifood.com.br (só no .env, nunca no git)
IFOOD_MCP_CLIENT_ID=
IFOOD_MCP_CLIENT_SECRET=
# Redirect URL EXATAMENTE como cadastrada no Portal (padrão abaixo)
IFOOD_MCP_REDIRECT=http://localhost:8000/oauth/callback
# Scopes separados por espaço. Vazio = não envia scope (o iFood não lista scopes nos metadados).
# Se o login reclamar de scope, teste: openid profile email user:read discovery:read cart:read cart:write order:read
IFOOD_MCP_SCOPE=
# Modo real: o pedido para no carrinho; true = submitOrder de verdade (nunca pague Pix de conta de teste)
IFOOD_MCP_PERMITIR_ENVIO=false
